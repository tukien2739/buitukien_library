package com.example.library.service;

import com.example.library.repository.BorrowRepository;

import com.example.library.entity.Book;
import com.example.library.entity.Borrow;
import com.example.library.exception.BusinessException;
import com.example.library.exception.ResourceNotFoundException;
import com.example.library.repository.BookRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDate;
import java.util.List;

@Service
@RequiredArgsConstructor
public class BorrowService {

    private final BorrowRepository borrowRepository;
    private final BookRepository bookRepository;

    public List<Borrow> findActiveBorrows() {
        return borrowRepository.findByReturnDateIsNullOrderByDueDateAsc();
    }

    @Transactional
    public Borrow borrowBook(Borrow borrow) {
        Book book = bookRepository.findById(borrow.getBook().getId())
                .orElseThrow(() -> new ResourceNotFoundException("Sách không tồn tại!"));

        // 1. Kiểm tra số lượng sách trong kho
        if (book.getQuantity() <= 0) {
            throw new BusinessException("Sách '" + book.getTitle() + "' hiện đã hết trong kho!");
        }

        // 2. Kiểm tra email này có đang mượn chính cuốn này mà chưa trả không
        String email = borrow.getBorrowerEmail().trim();
        if (borrowRepository.existsByBorrowerEmailIgnoreCaseAndBookIdAndReturnDateIsNull(email, book.getId())) {
            throw new BusinessException("Email này đang mượn cuốn sách này và chưa trả!");
        }

        // 3. Kiểm tra hạn trả phải từ hôm nay trở đi
        if (borrow.getDueDate().isBefore(LocalDate.now())) {
            throw new BusinessException("Hạn trả phải lớn hơn hoặc bằng ngày hôm nay!");
        }

        // 4. Giảm số lượng sách đi 1 và lưu phiếu mượn
        book.setQuantity(book.getQuantity() - 1);
        bookRepository.save(book);

        borrow.setBook(book);
        borrow.setBorrowerEmail(email);
        borrow.setBorrowDate(LocalDate.now());
        borrow.setReturnDate(null);
        return borrowRepository.save(borrow);
    }

    @Transactional
    public Borrow returnBook(Long borrowId) {
        Borrow borrow = borrowRepository.findById(borrowId)
                .orElseThrow(() -> new ResourceNotFoundException("Không tìm thấy phiếu mượn!"));

        if (borrow.getReturnDate() != null) {
            throw new BusinessException("Phiếu mượn này đã được trả trước đó!");
        }

        // Cập nhật ngày trả và cộng lại 1 cuốn vào kho
        borrow.setReturnDate(LocalDate.now());
        Book book = borrow.getBook();
        book.setQuantity(book.getQuantity() + 1);
        bookRepository.save(book);

        return borrowRepository.save(borrow);
    }
}